---
import Layout from "@/layouts/Layout.astro"

import About from "@/components/sections/About.astro"
import Education from "@/components/sections/Education.astro"
import Experience from "@/components/sections/Experience.astro"
import Hero from "@/components/sections/Hero.astro"
import Projects from "@/components/sections/Projects.astro"
import Skills from "@/components/sections/Skills.astro"
import KeyboardManager from "@/components/KeyboardManager.astro"

import { basics } from "@cv"
const { name, label } = basics
---

<Layout title={name + " Portfolio - " + label}>
  <main id="main-content">
    <Hero set:html={basics} />
    <About set:html={basics} />
    <Experience set:html={basics} />
    <Education set:html={basics} />
    <Projects set:html={basics} />
    <Skills set:html={basics} />
  </main>

  <!-- <KeyboardManager /> -->
</Layout>

<script is:inline>
  var cvData = { en: null, es: null };

  async function loadCVData() {
    try {
      var enRes = await fetch('/Portfolio/cv-en.json');
      var esRes = await fetch('/Portfolio/cv-es.json');
      cvData.en = await enRes.json();
      cvData.es = await esRes.json();
      updateLangDisplay();
      updateContent();
    } catch (err) {
      console.error('Failed to load CV data:', err);
    }
  }

  var currentLang = localStorage.getItem('portfolio-lang') || 'en';

  function updateLangDisplay() {
    var langText = document.getElementById('lang-text');
    if (langText) langText.textContent = currentLang === 'en' ? 'ES' : 'EN';
    document.documentElement.lang = currentLang === 'en' ? 'en' : 'es';
  }

  function updateContent() {
    var cv = cvData[currentLang];
    if (!cv) return;

    var heroName = document.querySelector('.info h1');
    var heroLabel = document.querySelector('.info h2');
    var heroLocation = document.querySelector('.info span');
    if (heroName) heroName.textContent = cv.basics.name;
    if (heroLabel) heroLabel.textContent = cv.basics.label;
    if (heroLocation && cv.basics.location) {
      var city = cv.basics.location.city;
      var region = cv.basics.location.region;
      if (city || region) {
        heroLocation.innerHTML = '<svg class="icon" aria-hidden="true"><use href="#world-map"></use></svg> ' + city + ', ' + region;
      }
    }

    var aboutP = document.querySelector('#about p');
    if (aboutP) aboutP.textContent = cv.basics.summary;

    var expSection = document.querySelector('#experience ul');
    if (expSection && cv.work) {
      expSection.innerHTML = cv.work.map(function(w) {
        return '<li><article><header><div><h3>' + (w.url ? '<a href="' + w.url + '" title="Ver ' + w.name + '" target="_blank">' + w.name + '</a>' : w.name) + '</h3><h4>' + w.position + '</h4></div><div style="color: #efd874;"><time datetime="' + w.startDate + '" data-title="' + w.startDate + '">' + new Date(w.startDate).getFullYear() + '</time> - <time datetime="' + (w.endDate || 'present') + '" data-title="' + (w.endDate || 'present') + '">' + (w.endDate ? new Date(w.endDate).getFullYear() : 'Today') + '</time></div></header><footer><p>' + w.summary + '</p></footer></article></li>';
      }).join('');
    }

    var eduSection = document.querySelector('#education ul');
    if (eduSection && cv.education) {
      eduSection.innerHTML = cv.education.map(function(e) {
        return '<li><article><header><div><h3>' + e.institution + '</h3></div><time>' + new Date(e.startDate).getFullYear() + ' - ' + (e.endDate ? new Date(e.endDate).getFullYear() : 'Actual') + '</time></header><footer><p>' + e.area + '</p></footer></article></li>';
      }).join('');
    }

    var projSection = document.querySelector('#projects ul');
    if (projSection && cv.projects) {
      projSection.innerHTML = cv.projects.map(function(p) {
        return '<li><article><header><h3><a href="' + p.url + '" target="_blank" title="Ver el proyecto ' + p.name + '">' + p.name + '</a>' + (p.isActive ? '<span>•</span>' : '') + (p.github ? '<a class="github-code-link" href="' + p.github + '" target="_blank" title="Ver código fuente del proyecto ' + p.name + '"><svg class="icon" aria-hidden="true"><use href="#github"></use></svg></a>' : '') + '</h3><p>' + p.description + '</p></header><footer>' + (p.highlights ? p.highlights.map(function(h) { return '<span>' + h + '</span>'; }).join('') : '') + '</footer></article></li>';
      }).join('');
    }

    var skillsSection = document.querySelector('#skills ul');
    if (skillsSection && cv.skills) {
      skillsSection.innerHTML = cv.skills.map(function(s) {
        return '<li><span class="skill-name">' + s.name + '</span><span class="skill-level">' + s.level + '</span></li>';
      }).join('');
    }

    var cvBtn = document.querySelector('.cv-button');
    if (cvBtn) cvBtn.href = currentLang === 'en' ? '/Portfolio/cv/Saydenier-Palacios-ENG.pdf' : '/Portfolio/cv/Saydenier-Palacios-ESP.pdf';
  }

  loadCVData();

  var langToggle = document.getElementById('lang-toggle');
  if (langToggle) {
    langToggle.addEventListener('click', function() {
      currentLang = currentLang === 'en' ? 'es' : 'en';
      localStorage.setItem('portfolio-lang', currentLang);
      updateLangDisplay();
      updateContent();
    });
  }
</script>

<style>
  main {
    padding: 4rem;
    margin: auto;
    width: 100%;
  }

  @media (width <= 700px) {
    main {
      padding: 2rem;
    }
  }
</style>